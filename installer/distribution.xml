<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Gain</title>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.txt" mime-type="text/plain"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="ch.danikoenig.gain.vst3"/>
            <line choice="ch.danikoenig.gain.au"/>
            <line choice="ch.danikoenig.gain.clap"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="ch.danikoenig.gain.vst3" visible="false">
        <pkg-ref id="ch.danikoenig.gain.vst3"/>
    </choice>
    <choice id="ch.danikoenig.gain.au" visible="false">
        <pkg-ref id="ch.danikoenig.gain.au"/>
    </choice>
    <choice id="ch.danikoenig.gain.clap" visible="false">
        <pkg-ref id="ch.danikoenig.gain.clap"/>
    </choice>
    <pkg-ref id="ch.danikoenig.gain.clap" version="@VERSION@" onConclusion="none">GainCLAP.pkg</pkg-ref>
    <pkg-ref id="ch.danikoenig.gain.vst3" version="@VERSION@" onConclusion="none">GainVST3.pkg</pkg-ref>
    <pkg-ref id="ch.danikoenig.gain.au" version="@VERSION@" onConclusion="none">GainAU.pkg</pkg-ref>
</installer-gui-script>
